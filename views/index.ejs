<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
  /* ===== Chessboard Container ===== */
/* ===== Chessboard ===== */
.chessboard {
  width: 400px;
  height: 400px;
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(8, 1fr);
  border-radius: 8px;
   overflow: hidden;
}


/* Flip board for black */
.flipped {
  transform: rotate(180deg);
}

/* Keep pieces upright */
.flipped .piece {
  transform: rotate(180deg);
}

/* ===== Squares ===== */
.square {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;
  aspect-ratio: 1 / 1;
}


.square.light {
  background-color: #f0d9b5;
}

.square.dark {
  background-color: #b58863;
}

/* ===== Pieces ===== */
.piece {
  font-size: 36px;
  cursor: pointer;
  user-select: none;
   line-height: 1;
  font-family: "Segoe UI Symbol", "Noto Sans Symbols", serif;
}

.piece.white {
  color: white;
  filter: drop-shadow(0 0 2px rgba(0, 0, 0, 1));
}

.piece.black {
  color: #111;
}

/* Drag feedback */
.dragging {
  opacity: 0.6;
}

/* ===== Demo Toggle (simple, not intrusive) ===== */
.demo-toggle {
  position: fixed;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);

  padding: 10px 14px;
  font-size: 14px;
  font-weight: 600;

  background: #c95c5c;
  color: #fff;

  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.demo-toggle:hover {
  background: #e15d5d;
}

.game-status {
  position: fixed;
  left: 50%;
  top: 18px;
  transform: translateX(-50%);
  z-index: 30;
  padding: 8px 12px;
  border-radius: 8px;
  color: #f3f4f6;
  background: rgba(0, 0, 0, 0.7);
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: 13px;
  font-weight: 600;
}

.game-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 40;
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease;
  background: rgba(0, 0, 0, 0.45);
}

.game-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.overlay-card {
  min-width: 240px;
  max-width: 90vw;
  background: #111827;
  border-radius: 10px;
  padding: 16px;
  text-align: center;
  color: #f9fafb;
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
}

.overlay-title {
  margin: 0 0 8px;
  font-size: 20px;
  font-weight: 700;
}

.overlay-subtitle {
  margin: 0;
  font-size: 13px;
  color: #e5e7eb;
}


    </style>
<script src="https://cdn.tailwindcss.com"></script>

</head>
<body>
    <button id="demoToggle" class="demo-toggle flex   ">Demo Mode: OFF</button>
    <div id="gameStatus" class="game-status">White to move</div>

    <div id="gameOverlay" class="game-overlay" aria-live="polite">
      <div id="overlayCard" class="overlay-card">
        <h2 id="overlayTitle" class="overlay-title">Game Over</h2>
        <p id="overlaySubtitle" class="overlay-subtitle">Resetting board...</p>
      </div>
    </div>

  <div class="w-full h-screen  flex items-center justify-center  bg-zinc-900">
    <div class='chessboard w-96 h-96 bg-red-800'></div>
  </div>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js" integrity="sha512-xRllwz2gdZciIB+AkEbeq+gVhX8VB8XsfqeFbUh+SzHlN96dEduwtTuVuc2u9EROlmW9+yhRlxjif66ORpsgVA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script src="/javascripts/chessgame.js"></script>
</body>
</html>
